<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovatewithomer.juiceforu.controller.RecipeController" stylesheets="@./styles/style.css">
    <VBox spacing="3" styleClass="page-header"><Label text="Recipe builder" styleClass="section-title"/><Label text="Map menu items to ingredients so stock is deducted correctly." styleClass="page-subtitle"/></VBox>
    <VBox spacing="12" styleClass="form-card"><HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="MENU ITEM" styleClass="eyebrow"/><ComboBox fx:id="menuItemCombo" maxWidth="Infinity"/></VBox><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="INGREDIENT" styleClass="eyebrow"/><ComboBox fx:id="ingredientCombo" maxWidth="Infinity"/></VBox><VBox spacing="4"><Label text="QUANTITY" styleClass="eyebrow"/><TextField fx:id="quantityField" promptText="0.00" prefWidth="130"/></VBox><Button text="＋ Add ingredient" onAction="#handleAddRecipe" styleClass="btn-primary" alignment="BOTTOM_CENTER"/></HBox></VBox>
    <TableView fx:id="recipeTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Choose an item and add its ingredients"/></placeholder><columns><TableColumn fx:id="colIngredient" text="INGREDIENT" prefWidth="330"/><TableColumn fx:id="colQuantity" text="QUANTITY NEEDED" prefWidth="220"/><TableColumn fx:id="colUnit" text="UNIT" prefWidth="160"/></columns></TableView>
    <HBox spacing="10"><Button text="Update selected" onAction="#handleEditRecipe" styleClass="button-edit"/><Button text="Delete selected" onAction="#handleDeleteRecipe" styleClass="btn-danger"/></HBox>
</VBox>
