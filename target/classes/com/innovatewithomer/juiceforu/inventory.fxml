<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovatewithomer.juiceforu.controller.InventoryController" stylesheets="@./styles/style.css">
    <VBox spacing="3" styleClass="page-header"><Label text="Stock inventory" styleClass="section-title"/><Label text="Keep ingredient quantities accurate for automatic recipe deductions." styleClass="page-subtitle"/></VBox>
    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS"><placeholder><Label text="No inventory items found"/></placeholder><columns><TableColumn fx:id="colItemId" text="ID" prefWidth="80"/><TableColumn fx:id="colItemName" text="INGREDIENT" prefWidth="300"/><TableColumn fx:id="colQuantity" text="QUANTITY" prefWidth="180"/><TableColumn fx:id="colUnit" text="UNIT" prefWidth="160"/></columns></TableView>
    <VBox spacing="12" styleClass="form-card"><VBox spacing="2"><Label text="Inventory item" styleClass="card-title"/><Label text="Select a row to update it, or enter new values to add stock." styleClass="helper-text"/></VBox><HBox spacing="10"><TextField fx:id="itemNameField" promptText="Ingredient name" HBox.hgrow="ALWAYS"/><TextField fx:id="quantityField" promptText="Quantity" prefWidth="140"/><TextField fx:id="unitField" promptText="Unit (ml, g, pcs)" prefWidth="160"/><Button text="＋ Add" onAction="#handleAdd" styleClass="btn-primary"/><Button text="Update" onAction="#handleUpdate" styleClass="button-edit"/><Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/></HBox></VBox>
</VBox>
