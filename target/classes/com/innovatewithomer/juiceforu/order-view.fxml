<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innovatewithomer.juiceforu.controller.OrderController"
            stylesheets="@./styles/style.css">

    <!-- LEFT SIDE: MENU -->
    <left>
        <VBox spacing="14" styleClass="side-panel">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <!-- Title -->
            <Label text="Menu" styleClass="section-title"/>

            <!-- Search & Filter -->
            <HBox spacing="10">
                <TextField fx:id="searchField"
                           promptText="🔍 Search item..."
                           prefWidth="200"
                           prefHeight="36"
                           styleClass="input-rounded"/>
                <ComboBox fx:id="categoryFilter"
                          promptText="All Categories"
                          prefWidth="140"
                          prefHeight="36"
                          styleClass="input-rounded"/>
            </HBox>

            <!-- Menu List -->
            <ListView fx:id="menuList"
                      prefWidth="300"
                      prefHeight="480"
                      styleClass="menu-list"/>
        </VBox>
    </left>

    <!-- RIGHT SIDE: ORDER PANEL -->
    <center>
        <VBox spacing="18" styleClass="order-panel">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Current Order" styleClass="section-title"/>
                <Label fx:id="orderIdLabel"
                       text="Order #0001"
                       style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Order Table -->
            <TableView fx:id="orderTable"
                       prefHeight="340"
                       styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colItem" text="Item" prefWidth="170"/>
                    <TableColumn fx:id="colQty" text="Qty" prefWidth="80"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="130"/>
                </columns>
            </TableView>

            <!-- Order Details Section -->
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="100"/>
                    <ColumnConstraints prefWidth="180"/>
                    <ColumnConstraints halignment="RIGHT" prefWidth="80"/>
                    <ColumnConstraints prefWidth="220"/>
                </columnConstraints>

                <!-- Order Type -->
                <Label text="Order Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="orderTypeCombo"
                          prefWidth="160"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="Charges:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="chargesField"
                           promptText="Charges"
                           disable="true"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="3"/>

                <!-- Phone -->
                <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField"
                           promptText="Enter customer phone"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           GridPane.columnSpan="3"/>

                <!-- Address -->
                <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="addressField"
                           promptText="Enter customer address"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           GridPane.columnSpan="3"/>
            </GridPane>

            <!-- Summary Section -->
            <VBox spacing="10" styleClass="summary-box">
                <Label fx:id="subtotalLabel" text="Subtotal: Rs. 0" styleClass="summary-text"/>
                <Label fx:id="totalLabel" text="Total: Rs. 0" styleClass="summary-total"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="printReceiptCheck" text="🖨️ Print Receipt" selected="true"/>
                </HBox>

                <Button text="💾 Save Order"
                        onAction="#onSaveOrderClick"
                        styleClass="btn-success-light"
                        maxWidth="Infinity"/>
            </VBox>

        </VBox>
    </center>
</BorderPane>
