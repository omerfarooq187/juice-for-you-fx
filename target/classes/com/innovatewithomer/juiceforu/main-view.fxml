<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Line?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.innovatewithomer.juiceforu.MainMenuController"
            stylesheets="@./styles/style.css">

    <!-- Sidebar -->
    <left>
        <VBox spacing="10" styleClass="sidebar">
            <Label text="🍹 Juice For U" styleClass="sidebar-title"/>

            <Line startX="0" startY="0" endX="200" endY="0" style="-fx-stroke: #e0e0e0; -fx-stroke-width: 1;"/>

            <Button text="📊 Dashboard" onAction="#onDashboardClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
            <Button text="➕ New Order" onAction="#onNewOrderClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
            <Button text="📜 Order History" onAction="#onOrderHistoryClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
            <Button text="🍴 Menu Items" onAction="#onMenuClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
            <Button text="📦 Inventory" onAction="#onInventoryClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
            <Button text="📜 Recipe" onAction="#onRecipeClick" maxWidth="Infinity" styleClass="btn-sidebar"/>
<!--            <Button text="⚙ Settings" onAction="#onSettingsClick" maxWidth="Infinity" styleClass="btn-sidebar"/>-->
            <Button text="🚪 Exit" onAction="#onExitClick" maxWidth="Infinity" styleClass="btn-sidebar-exit"/>
        </VBox>
    </left>

    <!-- Header -->
    <top>
        <HBox styleClass="header-bar">
            <Label fx:id="headerTitle" text="Dashboard" styleClass="h2"/>
        </HBox>
    </top>

    <!-- Dynamic center area where contents will be swapped -->
    <center>
        <BorderPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
