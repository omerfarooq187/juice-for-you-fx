<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.PieChart?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@./styles/style.css" fx:controller="com.innovatewithomer.juiceforu.controller.DashboardController">
<VBox spacing="18" styleClass="page">
    <VBox spacing="3" styleClass="page-header"><Label text="Today at a glance" styleClass="section-title"/><Label text="Live sales performance and the latest activity from your counter." styleClass="page-subtitle"/></VBox>
    <HBox spacing="16">
        <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="metric-card"><HBox alignment="CENTER_LEFT" spacing="9"><Label text="↗" styleClass="metric-icon"/><Label text="Today's sales" styleClass="metric-title"/></HBox><Label fx:id="salesLabel" text="Rs. 0" styleClass="metric-value-success"/><Label text="Recorded since midnight" styleClass="metric-sub"/></VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="metric-card"><HBox alignment="CENTER_LEFT" spacing="9"><Label text="▤" styleClass="metric-icon"/><Label text="Today's orders" styleClass="metric-title"/></HBox><Label fx:id="ordersLabel" text="0" styleClass="metric-value-info"/><Label text="Completed and open orders" styleClass="metric-sub"/></VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="metric-card"><HBox alignment="CENTER_LEFT" spacing="9"><Label text="◎" styleClass="metric-icon"/><Label text="Average order" styleClass="metric-title"/></HBox><Label fx:id="avgOrderLabel" text="Rs. 0" styleClass="metric-value"/><Label text="Based on today's sales" styleClass="metric-sub"/></VBox>
    </HBox>
    <HBox VBox.vgrow="ALWAYS" spacing="16">
        <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card"><Label text="Top-selling items" styleClass="card-title"/><Label text="Share of items sold today" styleClass="helper-text"/><PieChart fx:id="topItemsChart" VBox.vgrow="ALWAYS" legendVisible="true"/></VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card"><Label text="Recent orders" styleClass="card-title"/><Label text="Your five latest transactions" styleClass="helper-text"/><TableView fx:id="recentOrdersTable" VBox.vgrow="ALWAYS"><placeholder><Label text="No orders yet"/></placeholder><columns><TableColumn fx:id="orderIdCol" text="ORDER" prefWidth="110"/><TableColumn fx:id="totalCol" text="TOTAL (RS.)" prefWidth="140"/><TableColumn fx:id="createdAtCol" text="DATE &amp; TIME" prefWidth="220"/></columns></TableView></VBox>
    </HBox>
</VBox>
</ScrollPane>
