<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox spacing="16" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovatewithomer.juiceforu.controller.MenuController" stylesheets="@./styles/style.css">
    <VBox spacing="3" styleClass="page-header"><Label text="Menu catalog" styleClass="section-title"/><Label text="Manage the products and prices available at checkout." styleClass="page-subtitle"/></VBox>
    <TableView fx:id="menuTable" VBox.vgrow="ALWAYS"><placeholder><Label text="No menu items found"/></placeholder><columns><TableColumn fx:id="colId" text="ID" prefWidth="60"/><TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="175"/><TableColumn fx:id="colName" text="ITEM NAME" prefWidth="210"/><TableColumn fx:id="colSize" text="SIZE" prefWidth="90"/><TableColumn fx:id="colPrice" text="PRICE (RS.)" prefWidth="130"/><TableColumn fx:id="colActions" text="ACTIONS" prefWidth="180"/></columns></TableView>
    <VBox spacing="12" styleClass="form-card"><VBox spacing="2"><Label text="Add a menu item" styleClass="card-title"/><Label text="All fields are required; price must be greater than zero." styleClass="helper-text"/></VBox><HBox spacing="10"><TextField fx:id="txtCategory" promptText="Category" HBox.hgrow="ALWAYS"/><TextField fx:id="txtName" promptText="Item name" HBox.hgrow="ALWAYS"/><TextField fx:id="txtSize" promptText="Size" prefWidth="100"/><TextField fx:id="txtPrice" promptText="Price" prefWidth="120"/><Button text="＋ Add item" onAction="#onAddItemClick" styleClass="btn-primary"/></HBox></VBox>
</VBox>
