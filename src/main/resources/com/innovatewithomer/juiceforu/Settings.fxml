<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.image.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-host" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.innovatewithomer.juiceforu.controller.SettingsController" stylesheets="@./styles/style.css">
<content><VBox spacing="16" styleClass="page">
    <VBox spacing="3" styleClass="page-header"><Label text="Application settings" styleClass="section-title"/><Label text="Configure receipt printing, automatic backups, and database maintenance." styleClass="page-subtitle"/></VBox>
    <VBox spacing="14" styleClass="card">
        <VBox spacing="3"><Label text="Receipt printer" styleClass="card-title"/><Label text="Orders print to the selected system printer when “Print receipt” is enabled." styleClass="helper-text"/></VBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><ComboBox fx:id="printerCombo" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Select or type a printer name"/><Button text="Refresh printers" onAction="#onRefreshPrintersClick" styleClass="btn-refresh"/></HBox>
        <Label fx:id="printerStatusLabel" text="Looking for printers…" styleClass="helper-text"/>
    </VBox>
    <VBox spacing="12" styleClass="card">
        <VBox spacing="3"><Label text="Business day" styleClass="card-title"/><Label text="Choose when a new sales day begins. Orders before this time belong to the previous business day." wrapText="true" styleClass="helper-text"/></VBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><Label text="Day starts at"/><TextField fx:id="businessDayStartField" promptText="01:00" prefColumnCount="6"/><Label text="24-hour time (HH:mm). Use 01:00 for a shop that closes at 1 AM." wrapText="true" styleClass="helper-text"/></HBox>
    </VBox>
    <VBox spacing="14" styleClass="card">
        <VBox spacing="3"><Label text="Database backups" styleClass="card-title"/><Label text="Backups are consistent standalone SQLite files and can be copied to another computer." styleClass="helper-text"/></VBox>
        <HBox alignment="CENTER_LEFT" spacing="10"><TextField fx:id="backupDirectoryField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button text="Choose folder" onAction="#onChooseBackupDirectoryClick"/></HBox>
        <CheckBox fx:id="automaticBackupCheck" text="Create one automatic backup each day when the app starts" selected="true"/>
        <HBox alignment="CENTER_LEFT" spacing="10"><Button fx:id="backupNowButton" text="Back up now" onAction="#onBackupNowClick" styleClass="btn-primary"/><Label fx:id="lastBackupLabel" text="No successful backup recorded yet" styleClass="helper-text"/></HBox>
    </VBox>
    <VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS">
        <VBox spacing="3"><Label text="Database health" styleClass="card-title"/><Label text="The live database is stored in your private operating-system application-data folder." styleClass="helper-text"/></VBox>
        <Label text="DATABASE LOCATION" styleClass="eyebrow"/><Label fx:id="databasePathLabel" text="—" wrapText="true"/>
        <Label fx:id="databaseStatusLabel" text="Checking database…" styleClass="helper-text"/>
        <HBox><Button text="Run integrity check" onAction="#onCheckDatabaseClick" styleClass="button-edit"/><Region HBox.hgrow="ALWAYS"/><Button text="Save settings" onAction="#onSaveSettingsClick" styleClass="btn-primary"/></HBox>
    </VBox>
    <VBox spacing="12" styleClass="card about-card">
        <Label text="About this app" styleClass="card-title"/>
        <HBox alignment="CENTER_LEFT" spacing="18">
            <ImageView fx:id="settingsLogo" fitWidth="172" fitHeight="122" preserveRatio="true" smooth="true"/>
            <VBox alignment="CENTER_LEFT" spacing="7" HBox.hgrow="ALWAYS">
                <Label fx:id="settingsBusinessNameLabel" text="Point of Sale" styleClass="about-title"/>
                <Label fx:id="appVersionLabel" text="Point of sale" styleClass="helper-text"/>
                <Label text="Developed by InnovateWithOmer" styleClass="about-developer" wrapText="true"/>
                <Hyperlink text="innovatewithomer.dev" onAction="#onDeveloperWebsiteClick" styleClass="developer-link"/>
            </VBox>
        </HBox>
    </VBox>
</VBox></content>
</ScrollPane>
