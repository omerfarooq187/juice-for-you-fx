<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@./styles/style.css" fx:controller="com.innovatewithomer.juiceforu.controller.OrderHistoryController">
<VBox spacing="16" styleClass="page">
    <HBox alignment="CENTER_LEFT" styleClass="page-header"><VBox spacing="3"><Label text="Orders and sales" styleClass="section-title"/><Label text="Review transactions, update status, apply discounts, or reprint receipts." styleClass="page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><HBox spacing="8"><Button text="Today" styleClass="btn-filter" onAction="#onTodayFilter"/><Button text="7 days" styleClass="btn-filter" onAction="#onWeeklyFilter"/><Button text="This month" styleClass="btn-filter" onAction="#onMonthlyFilter"/><Button text="↻ Refresh" styleClass="btn-refresh" onAction="#onLoadOrdersClick"/></HBox></HBox>
    <HBox spacing="12"><Label fx:id="todaySalesLabel" text="Today: Rs. 0" styleClass="sales-label"/><Label fx:id="weeklySalesLabel" text="7 days: ****" styleClass="sales-label"/><Label fx:id="monthlySalesLabel" text="Month: ****" styleClass="sales-label"/><Region HBox.hgrow="ALWAYS"/><Button text="Apply discount" styleClass="btn-primary" onAction="#onApplyDiscountClick"/></HBox>
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"><placeholder><Label text="No orders found for this period"/></placeholder><columns><TableColumn fx:id="idColumn" text="ORDER" prefWidth="85"/><TableColumn fx:id="itemsColumn" text="ITEMS" prefWidth="230"/><TableColumn fx:id="totalColumn" text="TOTAL" prefWidth="105"/><TableColumn fx:id="dateColumn" text="CREATED" prefWidth="150"/><TableColumn fx:id="orderTypeColumn" text="TYPE" prefWidth="100"/><TableColumn fx:id="statusColumn" text="STATUS" prefWidth="125"/><TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="90"/></columns></TableView>
</VBox>
</ScrollPane>
